  "npcs": [
    {
      "id": "yara",
      "x": 610,
      "y": 790,
      "name": "Yara · Hacker",
      "assetId": "yara",
      "defaultFacing": -1,
      "facePlayerOnDialog": true,
      "text": "Robôs e cidadãos com implantes estão perdendo o controle. Os terminais dos telhados registraram as primeiras infecções. Matrona isolou o Setor 9 para impedir que as provas saiam daqui. Use este gancho nos pontos amarelos."
    },
    {
      "id": "oren-slum",
      "x": 1000,
      "y": 790,
      "name": "Oren · Mecânico",
      "assetId": "oren",
      "defaultFacing": -1,
      "facePlayerOnDialog": true,
      "shop": true,
      "text": "Posso reforçar sua proteção por 20 créditos. Procure dados e peças nos telhados; cada segredo financia a próxima melhoria."
