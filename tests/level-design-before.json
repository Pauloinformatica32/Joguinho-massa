    {
      "id": "scientist",
      "x": 3400,
      "y": 790,
      "name": "Dra. Íris Vale",
      "assetId": "iris",
      "defaultFacing": -1,
      "facePlayerOnDialog": true,
      "ability": "emp",
      "text": "Eu trabalhava para a Aurora Dynamics. Distribuímos o vírus em dispositivos novos e atualizações de implantes. Ele não foi feito para destruir: altera decisões de humanos e máquinas conectados. Warden protege a operação. Leve meu pulso eletromagnético."
    },
    {
      "id": "corporate-ai",
      "x": 5540,
      "y": 790,
      "name": "IA corporativa",
      "assetId": "npc_survivor",
      "text": "Segurança no primeiro andar. Pesquisa no segundo. Diretoria e transmissor no terceiro. O acesso exige autorização eletromagnética. Retorno ao complexo: saída à esquerda."
    }
